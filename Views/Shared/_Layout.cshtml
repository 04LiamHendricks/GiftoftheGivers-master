@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Active(string c, string a = "") => controller == c && (a == "" || action == a) ? "active" : "";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"] · Gift of the Givers</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg site-nav">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"/></svg>
                </span>
                Gift of the Givers
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div id="nav" class="collapse navbar-collapse">
                <ul class="navbar-nav mx-lg-auto gap-lg-1">
                    <li class="nav-item"><a class="nav-link @Active("Home", "Index")" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Home", "About")" asp-controller="Home" asp-action="About">About</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Donate")" asp-controller="Donate" asp-action="Index">Donate</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Volunteer")" asp-controller="Volunteer" asp-action="Register">Volunteer</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Home", "Contact")" asp-controller="Home" asp-action="Contact">Contact</a></li>
                    @if (User.IsInRole("Employee"))
                    {
                        <li class="nav-item"><a class="nav-link @Active("Employee")" asp-controller="Employee" asp-action="Dashboard">Dashboard</a></li>
                    }
                </ul>
                <div class="nav-actions d-flex align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="nav-user">Signed in as <strong>@User.Identity.Name</strong></span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button class="btn btn-ghost btn-sm">Log out</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-ghost btn-sm" asp-controller="Account" asp-action="Login">Log in</a>
                        <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Register</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="brand-line mb-2">Gift of the Givers</div>
                    <p class="mb-0" style="max-width:38ch">Humanitarian relief, dignified support and stronger communities, delivered with care when it matters most.</p>
                </div>
                <div class="col-6 col-lg-3 offset-lg-1">
                    <h4>Explore</h4>
                    <ul>
                        <li><a asp-controller="Home" asp-action="About">About us</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-3">
                    <h4>Get involved</h4>
                    <ul>
                        <li><a asp-controller="Donate" asp-action="Index">Donate</a></li>
                        <li><a asp-controller="Volunteer" asp-action="Register">Volunteer</a></li>
                        <li><a asp-controller="Account" asp-action="Register">Create an account</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between gap-2">
                <span>© @DateTime.UtcNow.Year Gift of the Givers. All rights reserved.</span>
                <span>ASP.NET Core prototype</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
