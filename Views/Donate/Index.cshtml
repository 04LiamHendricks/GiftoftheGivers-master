@model Donation
@{ ViewData["Title"] = "Donate"; }

<section class="page-section">
    <div class="container">
        <div class="form-shell">
            <div class="form-intro">
                <span class="section-eyebrow">Donate</span>
                <h1>Make a donation</h1>
                <p>Your gift helps us respond quickly to people in crisis.</p>
            </div>
            <div class="card form-card">
                <div class="card-body">
                    <div class="notice">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
                        <span>Prototype only. No payment is processed.</span>
                    </div>
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="DonationType"></label>
                                <select asp-for="DonationType" class="form-select"><option>One-time</option><option>Recurring</option></select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Currency"></label>
                                <select asp-for="Currency" class="form-select"><option>ZAR</option><option>USD</option><option>EUR</option></select>
                            </div>
                        </div>
                        <div class="mt-3">
                            <label asp-for="Amount"></label>
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="Amount" class="text-danger"></span>
                            <div class="amount-chips">
                                <button type="button" class="amount-chip" data-amount="100">100</button>
                                <button type="button" class="amount-chip" data-amount="250">250</button>
                                <button type="button" class="amount-chip" data-amount="500">500</button>
                                <button type="button" class="amount-chip" data-amount="1000">1000</button>
                            </div>
                        </div>
                        <div class="form-check mt-4">
                            <input asp-for="IsAnonymous" class="form-check-input" />
                            <label asp-for="IsAnonymous" class="form-check-label">Donate anonymously</label>
                        </div>
                        <button class="btn btn-warning btn-lg w-100 mt-4">Record donation</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.querySelectorAll('.amount-chip').forEach(function (chip) {
            chip.addEventListener('click', function () {
                var input = document.getElementById('Amount');
                if (input) { input.value = chip.dataset.amount; input.focus(); }
            });
        });
    </script>
}
