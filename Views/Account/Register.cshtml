@model RegisterViewModel
@{ ViewData["Title"] = "Register"; }

<section class="page-section">
    <div class="container">
        <div class="form-shell">
            <div class="form-intro">
                <span class="section-eyebrow">Join us</span>
                <h1>Create donor account</h1>
                <p>New registrations are assigned the Donor role.</p>
            </div>
            <div class="card form-card">
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName"></label>
                                <input asp-for="FirstName" class="form-control" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName"></label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <label asp-for="Email" class="mt-3"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>

                        <label asp-for="Password" class="mt-3"></label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>

                        <button class="btn btn-primary btn-lg w-100 mt-4">Register</button>
                    </form>
                    <p class="text-center small mt-4 mb-0">Already have an account? <a asp-controller="Account" asp-action="Login">Log in</a></p>
                </div>
            </div>
        </div>
    </div>
</section>
