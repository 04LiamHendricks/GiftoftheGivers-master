@{ ViewData["Title"] = "Home"; }

<section class="hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="hero-badge"><i></i> Humanitarian relief organisation</span>
                <h1>Bringing <span>hope</span> in times of crisis</h1>
                <p class="lead">Humanitarian relief, dignified support, and stronger communities. Give, volunteer, and see the impact of every contribution.</p>
                <div class="d-flex flex-wrap gap-3">
                    <a class="btn btn-warning btn-lg" asp-controller="Donate" asp-action="Index">Donate now</a>
                    <a class="btn btn-outline-light btn-lg" asp-controller="Volunteer" asp-action="Register">Become a volunteer</a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="hero-panel">
                    <h3>Why people give through us</h3>
                    <ul>
                        <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>Rapid response when disaster strikes</li>
                        <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>One-time or recurring giving in ZAR, USD or EUR</li>
                        <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>A donation certificate for every gift</li>
                        <li><span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>Volunteer opportunities that match your skills</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="page-section">
    <div class="container">
        <div class="section-title">
            <span class="section-eyebrow">What we do</span>
            <h2>Support that reaches people when it counts</h2>
            <p>From the first hours of an emergency to long-term recovery, our work is built around dignity and resilience.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 feature-card"><div class="card-body">
                    <div class="icon-tile amber"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg></div>
                    <h3>Disaster relief</h3>
                    <p>Fast support in urgent situations, from floods and fires to drought and displacement.</p>
                </div></div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 feature-card"><div class="card-body">
                    <div class="icon-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"/></svg></div>
                    <h3>Humanitarian aid</h3>
                    <p>Food, water, shelter and care delivered where it is needed most.</p>
                </div></div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 feature-card"><div class="card-body">
                    <div class="icon-tile ink"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
                    <h3>Community support</h3>
                    <p>Sustainable programmes that build lasting resilience in the communities we serve.</p>
                </div></div>
            </div>
        </div>
    </div>
</section>

<section class="page-section pt-0">
    <div class="container">
        <div class="section-title">
            <span class="section-eyebrow">How it works</span>
            <h2>Three simple ways to make a difference</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4 text-center">
                <div class="step-number mx-auto mb-3">1</div>
                <h3 class="fs-5">Give</h3>
                <p class="text-muted">Make a one-time or recurring donation and receive your certificate instantly.</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="step-number mx-auto mb-3">2</div>
                <h3 class="fs-5">Volunteer</h3>
                <p class="text-muted">Share your skills and availability and our team will match you to a need.</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="step-number mx-auto mb-3">3</div>
                <h3 class="fs-5">Stay informed</h3>
                <p class="text-muted">Create an account to stay connected to the work you are supporting.</p>
            </div>
        </div>
    </div>
</section>

<section class="page-section pt-0">
    <div class="container">
        <div class="cta-band">
            <h2>Ready to be part of the solution?</h2>
            <p>Every contribution, big or small, helps a family get back on their feet.</p>
            <a class="btn btn-warning btn-lg me-2" asp-controller="Donate" asp-action="Index">Donate now</a>
            <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Register">Create an account</a>
        </div>
    </div>
</section>
